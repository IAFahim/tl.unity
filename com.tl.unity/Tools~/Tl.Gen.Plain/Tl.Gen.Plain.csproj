<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TlGenSource Condition="'$(TlGenSource)' == ''">$(MSBuildThisFileDirectory)../../../external/tl-kinds/src/Tl.Gen.CSharp</TlGenSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(TlGenSource)/Analysis/*.cs" LinkBase="Linked/Analysis" />
    <Compile Include="$(TlGenSource)/Model/*.cs" LinkBase="Linked/Model" />
    <Compile Include="$(TlGenSource)/SystemEmitter.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/SystemGeneration.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/DerivedKindsEmitter.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/CompileArtifact.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Polyfills.cs" LinkBase="Linked" />
  </ItemGroup>

</Project>
