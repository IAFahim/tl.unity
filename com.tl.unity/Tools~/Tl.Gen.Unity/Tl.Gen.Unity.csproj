<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <TlGenSource Condition="'$(TlGenSource)' == ''">$(MSBuildThisFileDirectory)../../../external/tl-kinds/src/Tl.Gen.CSharp</TlGenSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(TlGenSource)/Analysis/SystemReader.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Analysis/NewStyle.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Analysis/Symbols.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Analysis/TypeAnalyzer.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Analysis/PairLayout.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Analysis/DeclarationDiagnostic.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Model/*.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Analysis/BakeReader.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Analysis/JobReader.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/CompileArtifact.cs" LinkBase="Linked" />
    <Compile Include="$(TlGenSource)/Polyfills.cs" LinkBase="Linked" />
  </ItemGroup>

</Project>
