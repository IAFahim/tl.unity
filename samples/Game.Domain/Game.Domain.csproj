<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Game.Domain</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageId>Tl.Sample.Game.Domain</PackageId>
    <Version>3.0.1-preview.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TlGenBackend>unity-entities</TlGenBackend>
    <TlGenAssembly>$(MSBuildThisFileDirectory)../../external/v3/src/Tl.Gen.CSharp/bin/Release/net10.0/Tl.Gen.CSharp.dll</TlGenAssembly>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/Tl.Runtime.Unity/Tl.Runtime.Unity.csproj" /></ItemGroup>
  <ItemGroup><None Include="README.md" Pack="true" PackagePath="/" /></ItemGroup>
  <Import Project="../../external/v3/src/Tl.Gen.CSharp/build/Tl.Gen.CSharp.targets" />
  <Target Name="CompileGeneratedBindings" BeforeTargets="CoreCompile" DependsOnTargets="TlGenExport" Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <ItemGroup><Compile Include="$(TlGenOutput)/*.g.cs" /></ItemGroup>
  </Target>
</Project>
